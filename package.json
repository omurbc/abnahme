{
  "name": "hackathon-team-name-finder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "start": "node --env-file=.local/env/eve.env --import=./scripts/env-guard.mjs start.mjs",
    "worker": "node --env-file=.local/env/buero.env --import=./scripts/env-guard.mjs worker.mjs",
    "api": "node --env-file=.local/env/buero-api.env --import=./scripts/env-guard.mjs agent-api.mjs",
    "board:snapshot": "node board/snapshot.mjs",
    "test": "node --test *.test.mjs board/*.test.mjs buero/*.test.mjs einvoice/*.test.mjs kosit/*.test.mjs mail/*.test.mjs mps/*.test.mjs rechnungsmeister/*.test.mjs scripts/*.test.mjs verifier/*.test.mjs && npm test --prefix gutachter"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@anthropic-ai/sdk": "1.3.0",
    "@e-invoice-eu/core": "3.4.2",
    "ai": "7.0.127",
    "eve": "0.71.0",
    "zod": "4.6.5"
  }
}
