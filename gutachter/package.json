{
  "name": "abnahme-gutachter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "wallet": "touch ../.env && chmod 600 ../.env && node --env-file-if-exists=../.env wallet.mjs && node ../scripts/env-split.mjs",
    "seller": "node --env-file=../.local/env/gutachter-seller.env seller.mjs",
    "buy": "node --env-file=../.local/env/gutachter-buyer.env buy.mjs",
    "balance": "node --env-file=../.local/env/gutachter-buyer.env balance.mjs",
    "test": "node --test *.test.mjs"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.14",
    "@x402/cardano": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/express": "2.26.0",
    "@x402/fetch": "2.26.0",
    "express": "^4.21.0"
  }
}
